<?php
session_start();
include 'database.php'; // Σύνδεση με τη βάση δεδομένων

// Ενεργοποίηση της εμφάνισης σφαλμάτων για έλεγχο
error_reporting(E_ALL);
ini_set('display_errors', 1);

// Έλεγχος αν ο χρήστης είναι συνδεδεμένος και αν ο ρόλος του είναι διασώστης
if (!isset($_SESSION['loggedin']) || $_SESSION['role'] !== 'diaswsths') {
    // Αν δεν είναι συνδεδεμένος ή δεν έχει τον ρόλο του διασώστη, ανακατεύθυνση στη σελίδα login
    header('Location: login.php');
    exit();
}
